#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
kuavo5 手臂轨迹脚本（安全修订版）

作用：让手臂从「当前姿势」平滑地走到「目标姿势」。

相对原版的改动：
  1. 内部统一用弧度，配置用「度」，自动换算，杜绝单位混用
  2. 关节顺序改为固定白名单，不再按字符串排序
  3. 默认剔除手部关节
  4. 逐关节幅度校验 + 可选限位校验
  5. 等到订阅者连接后再发布，避免前几帧丢失
  6. 起停用 min-jerk 平滑曲线，不再匀速硬起硬停
  7. 等待首帧用墙钟计时，仿真时钟不走也不会卡死
  8. 出错时打印「可直接复制」的关节列表

运行：python3 kuavo_arm_traj_safe.py
空跑：python3 kuavo_arm_traj_safe.py _dry_run:=true
"""

import math
import sys
import threading
import time

import rospy
from sensor_msgs.msg import JointState

# ==================================================================
# 一、配置区：一般只改这里的几个数字
# ==================================================================

JOINT_STATE_TOPIC = "/joint_states"     # 读关节状态的频道
ARM_TRAJ_TOPIC = "/kuavo_arm_traj"      # 发手臂目标的频道

# >>> 要改的只有这两行 <<<
TARGET_JOINT = "r_arm_pitch"            # 想动哪个关节
TARGET_DELTA_DEG = 10.0                 # 动多少「度」，正负号决定方向

MAX_STEP_DEG = 10.0      # 单个关节允许的最大移动幅度（度），超了就拒绝执行
DURATION = 3.0           # 运动总时长（秒）
RATE_HZ = 50.0           # 每秒发多少次
HOLD_SECONDS = 0.5       # 走完后继续保持目标位的时长（秒）

INCLUDE_HAND = False     # False = 不控制手指关节
STRICT_ORDER = True      # True = 关节必须齐全，缺一个就报错停下（推荐）
DRY_RUN = False          # True = 只打印不发布（第一次务必先空跑）

DEG = math.pi / 180.0    # 1 度 = 0.01745 弧度
RAD = 180.0 / math.pi    # 1 弧度 = 57.3 度

# 手臂关节的「标准顺序」。必须和机器人控制器约定的顺序一致。
# 第一次运行如果报「缺少关节」，把终端打印出来的列表复制过来替换这段即可。
ARM_ORDER = [
    # 左臂
    "l_arm_pitch", "l_arm_roll", "l_arm_yaw",
    "l_elbow_pitch", "l_forearm_yaw", "l_forearm_roll",
    # 左手（INCLUDE_HAND=False 时自动跳过）
    "l_hand_yaw", "l_hand_pitch", "l_hand_roll",
    # 右臂
    "r_arm_pitch", "r_arm_roll", "r_arm_yaw",
    "r_elbow_pitch", "r_forearm_yaw", "r_forearm_roll",
    # 右手
    "r_hand_yaw", "r_hand_pitch", "r_hand_roll",
]

# 可选：给单个关节设机械限位（单位：度）。留空表示不检查。
# 例：JOINT_LIMITS_DEG = {"r_arm_pitch": (-90.0, 90.0)}
JOINT_LIMITS_DEG = {}

# ==================================================================
# 二、关节状态缓存
# ==================================================================

_state = {}
_state_lock = threading.Lock()


def _joint_cb(msg):
    """收到一帧关节状态，存进字典。加锁，避免边读边写崩掉。"""
    if len(msg.name) != len(msg.position):
        return
    with _state_lock:
        for name, pos in zip(msg.name, msg.position):
            _state[name] = pos


def _snapshot():
    """复制一份当前状态，避免遍历时被别的线程改掉。"""
    with _state_lock:
        return dict(_state)


def _wait_first_frame(topic, timeout=10.0):
    """等第一帧数据。用墙钟计时，仿真时 ROS 时钟不走也不会卡死。"""
    t0 = time.time()
    while not rospy.is_shutdown():
        if _snapshot():
            return True
        if time.time() - t0 > timeout:
            rospy.logerr("等了 %.0f 秒没收到 %s。", timeout, topic)
            rospy.logerr("请检查：(1) 频道名有没有打错；(2) 机器人底层节点起了没有；"
                         "(3) 仿真时 /clock 是否在发布。")
            rospy.logerr("自查命令：rostopic echo -n1 %s", topic)
            return False
        time.sleep(0.05)          # 注意用 time.sleep，不是 rospy.sleep
    return False


# ==================================================================
# 三、关节挑选与排序
# ==================================================================

def _is_arm_joint(name):
    return ("_arm_" in name or "_elbow" in name
            or "_forearm" in name or "_hand_" in name)


def _wanted(name):
    """手部关节是否需要参与控制。"""
    if not INCLUDE_HAND and "_hand_" in name:
        return False
    return True


def _pick_joints(available, topic):
    """按白名单挑出关节。返回列表；失败返回 None。"""
    wanted_order = [n for n in ARM_ORDER if _wanted(n)]
    known = [n for n in wanted_order if n in available]
    missing = [n for n in wanted_order if n not in available]

    if missing and STRICT_ORDER:
        rospy.logerr("%s 里找不到下面 %d 个关节：", topic, len(missing))
        for n in missing:
            rospy.logerr("    - %s", n)
        detected = list(known)
        detected += sorted(n for n in available
                           if _is_arm_joint(n) and _wanted(n) and n not in detected)
        if not detected:
            rospy.logerr("一个手臂关节都没认出来，请先确认 %s 里到底有什么。", topic)
            return None
        rospy.logerr("这台机器实际检测到 %d 个手臂关节。把下面这段复制去替换 ARM_ORDER：",
                     len(detected))
        print("")
        print("ARM_ORDER = [")
        for n in detected:
            print("    %r," % n)
        print("]")
        print("")
        rospy.logerr("提示：如果只是刚启动还没收全，等 1 秒重跑一次再试。")
        return None

    if not STRICT_ORDER:
        extra = sorted(n for n in available
                       if _is_arm_joint(n) and _wanted(n)
                       and n not in known and n not in wanted_order)
        if extra:
            rospy.logwarn("有 %d 个关节不在白名单里，已按字母序追加到末尾：%s",
                          len(extra), ", ".join(extra))
            rospy.logwarn("如果动作不对，请把这些名字补进 ARM_ORDER 的正确位置。")
        known = known + extra

    return known


def _min_jerk(a):
    """0~1 的平滑曲线：首尾速度为 0、加速度也为 0，起停不顿挫。"""
    return a * a * a * (10.0 - 15.0 * a + 6.0 * a * a)


# ==================================================================
# 四、主流程
# ==================================================================

def main():
    rospy.init_node("kuavo_arm_traj_safe", anonymous=True)

    joint_topic = rospy.get_param("~joint_states_topic", JOINT_STATE_TOPIC)
    traj_topic = rospy.get_param("~arm_traj_topic", ARM_TRAJ_TOPIC)
    duration = float(rospy.get_param("~duration", DURATION))
    dry_run = bool(rospy.get_param("~dry_run", DRY_RUN))

    rospy.Subscriber(joint_topic, JointState, _joint_cb, queue_size=1)
    pub = rospy.Publisher(traj_topic, JointState, queue_size=10)

    rospy.loginfo("正在等待关节状态 %s ...", joint_topic)
    if not _wait_first_frame(joint_topic, 10.0):
        return 1

    available = _snapshot()
    joint_names = _pick_joints(available, joint_topic)
    if joint_names is None:
        return 1
    if not joint_names:
        rospy.logerr("没有可控制的手臂关节，停止。")
        return 1
    if TARGET_JOINT not in joint_names:
        rospy.logerr("目标关节 %r 不在控制列表里。当前列表：%s",
                     TARGET_JOINT, ", ".join(joint_names))
        rospy.logerr("请把第 40 行左右的 TARGET_JOINT 改成上面列表里的某一个名字。")
        return 1

    # ---------- 算目标 ----------
    starts = [available[n] for n in joint_names]
    targets = list(starts)
    idx = joint_names.index(TARGET_JOINT)
    targets[idx] = starts[idx] + TARGET_DELTA_DEG * DEG     # 度 -> 弧度，关键一行

    # ---------- 安全校验 ----------
    max_step = MAX_STEP_DEG * DEG
    for name, s, t in zip(joint_names, starts, targets):
        if abs(t - s) > max_step + 1e-9:
            rospy.logerr("关节 %s 要动 %.2f°，超过上限 %.1f°，拒绝执行。",
                         name, (t - s) * RAD, MAX_STEP_DEG)
            return 1
        limit = JOINT_LIMITS_DEG.get(name)
        if limit:
            lo, hi = limit
            if not (lo <= t * RAD <= hi):
                rospy.logerr("关节 %s 目标 %.1f° 超出限位 [%.1f, %.1f]，拒绝执行。",
                             name, t * RAD, lo, hi)
                return 1

    # ---------- 汇总 ----------
    rospy.loginfo("-" * 50)
    rospy.loginfo("目标关节 : %s", TARGET_JOINT)
    rospy.loginfo("当前角度 : %8.2f°  (%+.4f rad)", starts[idx] * RAD, starts[idx])
    rospy.loginfo("目标角度 : %8.2f°  (%+.4f rad)", targets[idx] * RAD, targets[idx])
    rospy.loginfo("参与关节 : %d 个 -> %s", len(joint_names), ", ".join(joint_names))
    rospy.loginfo("运动参数 : %.1f 秒 @ %.0f Hz，共 %d 帧",
                  duration, RATE_HZ, int(round(duration * RATE_HZ)) + 1)
    rospy.loginfo("运行模式 : %s", "空跑，不发布任何命令" if dry_run else "真实发布")
    rospy.loginfo("-" * 50)

    # ---------- 等订阅者，避免前几帧丢失 ----------
    if not dry_run:
        t0 = time.time()
        while pub.get_num_connections() == 0 and not rospy.is_shutdown():
            if time.time() - t0 > 5.0:
                rospy.logwarn("%s 上没有订阅者，继续发布，但前面几帧可能丢。", traj_topic)
                break
            rospy.loginfo_throttle(1.0, "等待 %s 的订阅者接入 ...", traj_topic)
            time.sleep(0.1)
        if rospy.is_shutdown():
            return 1

    # ---------- 插值发布 ----------
    steps = max(1, int(round(duration * RATE_HZ)))
    period = 1.0 / RATE_HZ
    msg = JointState()
    msg.header.frame_id = ""
    msg.name = list(joint_names)
    log_every = max(1, int(RATE_HZ / 5.0))

    t_next = time.time()
    for k in range(steps + 1):
        if rospy.is_shutdown():
            rospy.logwarn("收到停止信号，提前结束（手臂可能停在当前位置）。")
            return 0

        a = k / float(steps)
        s_curve = _min_jerk(a)
        msg.position = [st + (tg - st) * s_curve
                        for st, tg in zip(starts, targets)]
        msg.header.stamp = rospy.Time.now()
        if not dry_run:
            pub.publish(msg)

        if k % log_every == 0 or k == steps:
            rospy.loginfo("进度 %3d%%   %s = %7.2f°",
                          int(round(a * 100)), TARGET_JOINT, msg.position[idx] * RAD)

        t_next += period
        wait = t_next - time.time()
        if wait > 0:
            time.sleep(wait)

    # ---------- 保持目标位 ----------
    if HOLD_SECONDS > 0 and not dry_run:
        hold_frames = int(HOLD_SECONDS * RATE_HZ)
        for _ in range(hold_frames):
            if rospy.is_shutdown():
                break
            msg.position = list(targets)
            msg.header.stamp = rospy.Time.now()
            pub.publish(msg)
            time.sleep(period)

    rospy.loginfo("完成：%s 已到 %.2f°", TARGET_JOINT, targets[idx] * RAD)
    return 0


if __name__ == "__main__":
    exit_code = 0
    try:
        exit_code = main()
    except rospy.ROSInterruptException:
        rospy.logwarn("被中断，已停止发布（手臂可能停在当前位置）。")
        exit_code = 130
    except KeyboardInterrupt:
        rospy.logwarn("被 Ctrl-C 中断，已停止发布（手臂可能停在当前位置）。")
        exit_code = 130
    finally:
        try:
            rospy.signal_shutdown("finished")
        except Exception:
            pass
    sys.exit(exit_code if isinstance(exit_code, int) else 0)
